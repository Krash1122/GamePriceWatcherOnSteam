# Copy this file to .env and fill in your own values.
# .env is listed in .gitignore — never commit the real token.

# From the Discord developer portal, Bot tab, "Reset Token".
DISCORD_TOKEN=

# Optional. Right-click your test server in Discord (with Developer Mode on)
# and Copy Server ID. Set it and slash commands appear instantly; leave it
# blank and they sync globally, which can take up to an hour.
GUILD_ID=

# Optional. Minutes between price checks. Defaults to 30.
POLL_MINUTES=30

# Optional. Where the SQLite file lives. Defaults to watches.db next to bot.py.
DB_PATH=watches.db
